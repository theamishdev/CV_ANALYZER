PORT=3000
CORS_ORIGIN=http://localhost:4200
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/cv_analyzer
SESSION_SECRET=change_this_to_a_long_random_string

# Optional: enables deep AI-powered gap analysis (matchScore, missing skills,
# section-by-section suggestions, structured CV parsing). Without this key
# the app still works using the local ML title/experience classifier plus a
# built-in keyword-matching fallback analyzer.
XAI_API_KEY=
XAI_MODEL=grok-beta

# Telegram Bot Token (Get this from BotFather on Telegram)
TELEGRAM_BOT_TOKEN=
